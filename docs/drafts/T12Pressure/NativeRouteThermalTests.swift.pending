// APPEND to the end of Tests/RecordingTests/RecordingSessionOwnerTests.swift.
// Reuses only its existing same-file boundary doubles/real queue/converter/CAF
// helpers. No inference result or physical pressure event is fabricated.
#if os(iOS)
@MainActor
private final class T12NativePressureProbe {
    var inputAvailable = true
    var thermalState = ProcessInfo.ThermalState.nominal
}

@MainActor
extension RecordingSessionOwnerTests {
    func testNativeInputRouteLossStopsCaptureButCategoryChangeAndEndedSignalsDoNot() async throws {
        try await withHarness { h in
            try await recordOneBuffer(h)
            let oldTap = try XCTUnwrap(h.hardware.tap)
            let center = NotificationCenter()
            let pressure = T12NativePressureProbe()
            let monitor = IOSRecordingSignalMonitor(owner: h.owner, center: center,
                inputAvailable: { pressure.inputAvailable }, thermalState: { pressure.thermalState })
            monitor.beginEpoch(sessionID: h.id)
            defer { monitor.endEpoch(sessionID: h.id) }
            let postRoute: @MainActor (AVAudioSession.RouteChangeReason) -> Void = { reason in
                center.post(name: AVAudioSession.routeChangeNotification,
                    object: AVAudioSession.sharedInstance(),
                    userInfo: [AVAudioSessionRouteChangeReasonKey: reason.rawValue])
            }
            // During the app's own category change, route metadata may not yet
            // expose a capture input. That reason must not interrupt admission.
            pressure.inputAvailable = false
            postRoute(.categoryChange)
            center.post(name: AVAudioSession.interruptionNotification,
                object: AVAudioSession.sharedInstance(),
                userInfo: [AVAudioSessionInterruptionTypeKey: AVAudioSession.InterruptionType.ended.rawValue])
            try await complete { await monitor.flush() }
            var state = await h.owner.snapshot()
            XCTAssertEqual(state.phase, .recording)
            XCTAssertEqual(h.hardware.startCalls, 1)
            XCTAssertEqual(h.hardware.stopCalls, 0)
            // An output-device change with an available capture input does not
            // establish input loss. The OS input-availability boundary is queried.
            pressure.inputAvailable = true
            postRoute(.oldDeviceUnavailable)
            try await complete { await monitor.flush() }
            state = await h.owner.snapshot()
            XCTAssertEqual(state.phase, .recording)
            pressure.inputAvailable = false
            postRoute(.oldDeviceUnavailable)
            try await complete { await monitor.flush() }
            let interrupted = await h.owner.snapshot()
            XCTAssertEqual(interrupted.phase, .interrupted)
            XCTAssertFalse(interrupted.cleanupPending)
            XCTAssertNil(h.owner.completedManifest)
            XCTAssertFalse(h.hardware.sessionActive)
            XCTAssertFalse(h.hardware.engineRunning)
            XCTAssertNil(h.hardware.tap)
            let checkpoint = h.directory.appendingPathComponent("capture-manifest.json")
            let bytes = try? Data(contentsOf: checkpoint)
            XCTAssertNotNil(bytes)
            if let bytes {
                let manifest = try JSONDecoder().decode(AudioCaptureManifest.self, from: bytes)
                XCTAssertEqual(manifest.totalFrames, 64)
                XCTAssertEqual(try decode(manifest, directory: h.directory).count, 64)
            }
            oldTap(try signal(h), AVAudioTime(sampleTime: 40_064, atRate: h.hardware.format.sampleRate))
            XCTAssertEqual(try? Data(contentsOf: checkpoint), bytes)
            pressure.inputAvailable = true
            postRoute(.newDeviceAvailable)
            center.post(name: AVAudioSession.mediaServicesWereResetNotification,
                        object: AVAudioSession.sharedInstance())
            center.post(name: AVAudioSession.interruptionNotification,
                object: AVAudioSession.sharedInstance(),
                userInfo: [AVAudioSessionInterruptionTypeKey: AVAudioSession.InterruptionType.ended.rawValue])
            try await complete { await monitor.flush() }
            XCTAssertEqual(h.hardware.startCalls, 1, "Route/reset/recovery notifications cannot restart a stopped epoch")
            XCTAssertFalse(h.hardware.engineRunning)
            XCTAssertNil(h.owner.completedManifest)
        }
    }

    func testNativeCriticalThermalSignalDrainsCAFAndDoesNotHonorLatePermissionOrRestart() async throws {
        try await withHarness { h in
            try await recordOneBuffer(h)
            let center = NotificationCenter()
            let pressure = T12NativePressureProbe()
            let monitor = IOSRecordingSignalMonitor(owner: h.owner, center: center,
                inputAvailable: { pressure.inputAvailable }, thermalState: { pressure.thermalState })
            monitor.beginEpoch(sessionID: h.id)
            defer { monitor.endEpoch(sessionID: h.id); h.permission.resolve() }
            pressure.thermalState = .fair
            center.post(name: ProcessInfo.thermalStateDidChangeNotification, object: ProcessInfo.processInfo)
            try await complete { await monitor.flush() }
            let fair = await h.owner.snapshot()
            XCTAssertEqual(fair.phase, .recording)
            pressure.thermalState = .critical
            center.post(name: ProcessInfo.thermalStateDidChangeNotification, object: ProcessInfo.processInfo)
            try await complete { await monitor.flush() }
            let interrupted = await h.owner.snapshot()
            XCTAssertEqual(interrupted.phase, .interrupted)
            XCTAssertFalse(interrupted.cleanupPending)
            XCTAssertNil(h.owner.completedManifest)
            XCTAssertFalse(h.hardware.sessionActive)
            XCTAssertFalse(h.hardware.engineRunning)
            let bytes = try? Data(contentsOf: h.directory.appendingPathComponent("capture-manifest.json"))
            XCTAssertNotNil(bytes)
            if let bytes {
                let manifest = try JSONDecoder().decode(AudioCaptureManifest.self, from: bytes)
                XCTAssertEqual(manifest.totalFrames, 64)
                XCTAssertEqual(try decode(manifest, directory: h.directory).count, 64)
            }
            pressure.thermalState = .nominal
            center.post(name: ProcessInfo.thermalStateDidChangeNotification, object: ProcessInfo.processInfo)
            try await complete { await monitor.flush() }
            XCTAssertEqual(h.hardware.startCalls, 1, "Thermal recovery needs a new explicit recording action")
            // Quiesce a deliberately broken RED implementation before the
            // independent held-permission portion; all assertions above remain.
            try await complete { await h.owner.stop() }
            let replacement = UUID()
            h.preparation.result = .ready(directory: h.root.appendingPathComponent("thermal-pending"))
            h.permission.hold = true
            monitor.beginEpoch(sessionID: replacement)
            defer { monitor.endEpoch(sessionID: replacement) }
            let starting = Task { await h.owner.start(sessionID: replacement) }
            defer { starting.cancel(); h.permission.resolve() }
            let held = await ownerEventually { h.permission.isWaiting }
            XCTAssertTrue(held)
            pressure.thermalState = .critical
            center.post(name: ProcessInfo.thermalStateDidChangeNotification, object: ProcessInfo.processInfo)
            try await complete { await monitor.flush() }
            let pending = await h.owner.snapshot()
            XCTAssertEqual(pending.phase, .interrupted)
            XCTAssertNil(h.owner.completedManifest)
            h.permission.resolve()
            try await complete { await starting.value }
            XCTAssertEqual(h.hardware.startCalls, 1, "A late old grant cannot activate thermally interrupted capture")
            XCTAssertFalse(h.hardware.sessionActive)
            XCTAssertFalse(h.hardware.engineRunning)
        }
    }
}
#endif
