// APPLY AS A REPLACEMENT OF THE EXISTING ENUM, NOT AS A SECOND DEFINITION.
// Keep old compiler tests/API unchanged. Add unsupportedType to the existing
// error enum and the switch stub below to obtain meaningful nested-type RED.
// This fragment implements no recursive grammar compilation.
public indirect enum StructuredJSONType: Equatable, Sendable {
    case string
    case boolean
    case stringEnumeration([String])
    case stringArray(allowedValues: [String])
    case object([StructuredJSONField])
    case array(element: StructuredJSONType, maximumItems: Int)
    case nullable(StructuredJSONType)
    case integerEnumeration([Int64])
}

