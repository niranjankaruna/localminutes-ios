{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Windows CUDA EXE",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "windows/scripts/build-cuda.ps1"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Test Windows Python",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "windows/scripts/run-python.ps1",
        "-m",
        "pytest"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run Windows Python app",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "windows/scripts/run-python.ps1",
        "launch.py"
      ],
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
