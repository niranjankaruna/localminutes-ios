<Window x:Class="LocalMinutes.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LocalMinutes" Width="1440" Height="900" MinWidth="1000" MinHeight="680" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
  <Grid Background="{DynamicResource PageBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" Padding="20,24">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top"><TextBlock Text="LocalMinutes" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Your meetings, on device." Style="{StaticResource Caption}" Margin="0,8,0,36"/>
          <Button x:Name="MeetingsNav" Content="Meetings" Style="{StaticResource NavButton}" Click="ShowMeetings"/>
          <Button x:Name="RecordNav" Content="Record" Style="{StaticResource NavButton}" Click="ShowRecord"/>
          <Button x:Name="SyncNav" Content="Sync" Style="{StaticResource NavButton}" Click="ShowSync"/>
          <Button x:Name="SettingsNav" Content="Settings" Style="{StaticResource NavButton}" Click="ShowSettings"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock x:Name="DeviceName" FontWeight="SemiBold"/><TextBlock x:Name="DeviceId" Style="{StaticResource Caption}" Margin="0,8,0,8"/><TextBlock Text="Stored on this device" Style="{StaticResource Caption}"/></StackPanel>
        <Grid/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="MeetingsPage">
        <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" Padding="16,24,12,12" BorderThickness="1,0,0,0" BorderBrush="#EFF0F3">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top"><DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="+" Click="NewMeeting" ToolTip="Create a meeting for notes"/><TextBlock Text="Meetings" FontSize="25" FontWeight="SemiBold"/></DockPanel><TextBox x:Name="SearchBox" AutomationProperties.Name="Search meeting titles" TextChanged="SearchChanged" Margin="0,0,0,12"/></StackPanel>
            <TextBlock x:Name="MeetingCount" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="12"/>
            <ListBox x:Name="MeetingList" SelectionChanged="MeetingSelected" AutomationProperties.Name="Meeting history"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding DateLabel}" Style="{StaticResource Caption}" Margin="0,7,0,5"/><TextBlock Text="{Binding DurationLabel}" Style="{StaticResource Caption}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="24">
          <Grid x:Name="EmptyMeeting"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"><TextBlock Text="Keep the details." FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Create a meeting for notes, record a conversation, or import an iPhone library backup." Margin="0,16,0,24"/><Button Content="Create a meeting" Click="NewMeeting" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid>
          <Grid x:Name="MeetingDetail" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,20"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Sync" Click="ShowSync"/><Button Content="…" Click="MeetingMenu" AutomationProperties.Name="Meeting actions"/></StackPanel><TextBlock x:Name="MeetingTitle" FontSize="27" FontWeight="SemiBold"/></DockPanel><TextBlock x:Name="MeetingMetadata" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel>
            <TabControl x:Name="ContentTabs" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderThickness="0" SelectionChanged="ContentTabChanged">
              <TabItem Header="Summary"><DockPanel Margin="20"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0"><Button Content="Generate summary" Click="GenerateSummary"/><Button Content="Save edit" Click="SaveSummary"/><Button Content="Export" Click="ExportSummary"/><Button Content="Sources" Click="SummarySources"/></StackPanel><TextBox x:Name="SummaryText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="16" BorderThickness="0" AutomationProperties.Name="Summary text"/></DockPanel></TabItem>
              <TabItem Header="Transcript"><DockPanel Margin="16"><TextBox x:Name="TranscriptSearch" DockPanel.Dock="Top" Margin="0,0,0,12" TextChanged="TranscriptSearchChanged" AutomationProperties.Name="Search transcript"/><ListBox x:Name="TranscriptList" MouseDoubleClick="TranscriptSeek" AutomationProperties.Name="Transcript segments"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Timestamp}" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding Text}" FontSize="16" Margin="0,6,0,10"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></TabItem>
              <TabItem Header="Notes"><DockPanel Margin="20"><TextBlock x:Name="NotesState" DockPanel.Dock="Bottom" Text="Saved on this device" Style="{StaticResource Caption}" Margin="0,12,0,0"/><TextBox x:Name="NotesText" TextChanged="NotesChanged" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" FontSize="16" AutomationProperties.Name="Meeting notes"/></DockPanel></TabItem>
              <TabItem Header="Ask"><DockPanel Margin="20"><StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0"><TextBox x:Name="QuestionText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" AutomationProperties.Name="Ask about this meeting"/><Button Content="Ask this meeting" Click="AskMeeting" HorizontalAlignment="Right" Margin="0,12,0,0" Style="{StaticResource PrimaryButton}"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="AnswersList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,24"><TextBlock Text="{Binding Question}" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="{Binding EditedText}" Margin="0,10,0,0" FontSize="16"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Edit answer" Click="EditAnswer"/><Button Content="Sources" Click="AnswerSources"/></StackPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></TabItem>
            </TabControl>
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="Play" Click="PlayAudio"/><Button Content="Stop" Click="StopAudio"/></StackPanel><TextBlock x:Name="PlaybackStatus" Text="Original recording" VerticalAlignment="Center" Style="{StaticResource Caption}"/></DockPanel></Border>
          </Grid>
        </Grid>
      </Grid>
      <ScrollViewer x:Name="RecordPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="40" MaxWidth="960" HorizontalAlignment="Stretch"><TextBlock Text="Record" Style="{StaticResource Heading}"/><TextBlock Text="Capture a conversation with your microphone. Audio stays on this device." Margin="0,0,0,24"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Microphone" FontWeight="SemiBold"/><ComboBox x:Name="MicrophoneList" Margin="0,12,0,24" Padding="10" AutomationProperties.Name="Recording microphone"/><TextBlock x:Name="RecordingTimer" Text="00:00:00" FontSize="52" FontWeight="Light"/><TextBlock x:Name="RecordingState" Text="Ready to record" Margin="0,12,0,24"/><StackPanel Orientation="Horizontal"><Button x:Name="RecordButton" Content="Start recording" Click="ToggleRecording" Style="{StaticResource PrimaryButton}"/><Button Content="View meeting" Click="OpenRecording"/></StackPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Live transcript" FontSize="20" FontWeight="SemiBold"/><TextBox x:Name="LiveTranscript" Margin="0,16,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" MinHeight="160"/></StackPanel></Border></StackPanel></ScrollViewer>
      <ScrollViewer x:Name="SyncPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="40" MaxWidth="1000"><TextBlock Text="Sync" Style="{StaticResource Heading}"/><TextBlock Text="Copy new and updated meeting data directly to another device on your Wi-Fi." Margin="0,0,0,24"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="SyncDirection" Text="My Windows PC → My iPhone" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="This PC’s edits replace matching edits. Meetings only on your iPhone are kept. Models and deletions are not copied." Margin="0,16,0,20"/><TextBlock x:Name="SyncStatus" Text="Keep LocalMinutes open on both devices."/><StackPanel x:Name="SyncControls" Margin="0,20,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
      <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="40" MaxWidth="1000"><TextBlock Text="Settings" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Models" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Download models separately on this PC. Saved meeting data works without them." Margin="0,10,0,18"/><StackPanel x:Name="ModelControls"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Library and storage" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="StoragePath" Margin="0,10,0,20"/><WrapPanel><Button Content="Import iPhone backup" Click="ImportBackup"/><Button Content="Export library" Click="ExportBackup"/><Button Content="Open data folder" Click="OpenDataFolder"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Appearance" FontSize="21" FontWeight="SemiBold"/><CheckBox x:Name="DarkMode" Content="Dark appearance" Margin="0,16,0,0" Checked="ThemeChanged" Unchecked="ThemeChanged"/></StackPanel></Border><TextBlock Text="No account. No cloud transcription. Trusted-device sync uses your local network." Style="{StaticResource Caption}"/></StackPanel></ScrollViewer>
      <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="20,10"><TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource SecondaryBrush}" AutomationProperties.LiveSetting="Polite"/></Border>
    </Grid>
  </Grid>
</Window>
